server {
  listen 80;

  # Sürücü uygulamasının yol ağı verisi (~735 KB JSON) sıkıştırılınca ~250 KB.
  gzip on;
  gzip_types application/json application/javascript text/css;
  gzip_min_length 1024;
  root /usr/share/nginx/html;

  # API adresi Docker'ın DNS'inden istek anında çözülür (en fazla 10 sn önbellek). Açılışta bir
  # kez çözülseydi API container'ı yeniden oluşturulunca (deploy) nginx eski adrese gider ve iki
  # arayüz de nginx yeniden başlatılana kadar 502 alırdı.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream http://api:3000;

  location /api/ {
    # Değişkenli proxy_pass yolu kendisi değiştirmez: /api öneki burada atılır (sorgu korunur).
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    # API anahtarı eklenmez: iki uygulama da oturumla (Authorization: Bearer) istek atar;
    # sürücü sürücü hesabıyla, operasyon yönetici hesabıyla giriş yapar.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /socket.io/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 1h;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri /index.html;
  }
}
