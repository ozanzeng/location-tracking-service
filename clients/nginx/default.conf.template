server {
  listen 80;

  # Sürücü uygulamasının yol ağı verisi (~735 KB JSON) sıkıştırılınca ~250 KB.
  gzip on;
  gzip_types application/json application/javascript text/css;
  gzip_min_length 1024;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass http://api:3000/;
    # nginx imajı başlangıçta API_KEY ortam değişkenini buraya yerleştirir. Anahtar tarayıcı
    # kodunda görünmez ama bu nginx'e erişen herkes onun yetkisiyle istek atar; bu yüzden
    # sürücü uygulamasına sadece konum gönderebilen anahtar verilir (docker-compose.yml).
    proxy_set_header x-api-key "${API_KEY}";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /socket.io/ {
    proxy_pass http://api:3000;
    proxy_set_header x-api-key "${API_KEY}";
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 1h;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri /index.html;
  }
}
