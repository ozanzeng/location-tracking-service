PORT=3000
DB_HOST=localhost
DB_PORT=5444
DB_USER=geofence
DB_PASSWORD=geofence
DB_NAME=geofence
DB_POOL_SIZE=20
REDIS_URL=redis://localhost:6390
# Kullanıcı şeritleri (aynı anda işlenebilen iş sayısı); API ve worker'da aynı olmalı
QUEUE_LANES=64
# Docker'sız yerel geliştirmede şema sahibiyle bağlanılır. Uygulama rolü (en az yetki) için
# migrate betiğine DB_APP_USER/DB_APP_PASSWORD verilir, API ve worker'a DB_USER olarak o rol.
# DB_APP_USER=geofence_app
# DB_APP_PASSWORD=geofence_app
API_KEYS=dev-api-key
# Sadece konum gönderip alanları okuyabilen anahtar (sürücü uygulaması)
INGEST_API_KEYS=dev-driver-key
# CORS_ORIGINS=https://ops.example.com
# RATE_LIMIT_USER_PER_MIN=60
# QUEUE_MAX_BACKLOG=200000
# Kalıcı hatada nokta başına deneme; denemeler arası ilk ve en uzun bekleme (ikiye katlanır)
# WORKER_POINT_ATTEMPTS=3
# WORKER_RETRY_DELAY_MS=200
# WORKER_RETRY_MAX_DELAY_MS=5000
# Veritabanı kapalıyken konumlar bu süre bekletilir, kaybolmaz (5 dk)
# WORKER_TRANSIENT_RETRY_MS=300000
# İşin başarısız sayılmadan önce kaç kez "takıldı" (kilidi düştü) sayılabileceği
# WORKER_MAX_STALLED_COUNT=3
# Kapanışta çalışan işin bitmesi için en uzun bekleme; sonra iş başka worker'a kalır
# WORKER_SHUTDOWN_GRACE_MS=8000
# İncelemek için Redis'te tutulan iş sayısı (tüm şeritlerin toplamı)
# QUEUE_KEEP_COMPLETED=1000
# QUEUE_KEEP_FAILED=5000
# Çöken worker'ın işi en geç ~30 sn içinde başka worker'a geçer
# WORKER_LOCK_MS=20000
# WORKER_STALLED_CHECK_MS=5000
# Ping'e cevap vermeyen canlı yayın bağlantısı en geç 10 + 20 sn içinde kapatılır
# REALTIME_PING_INTERVAL_MS=10000
# REALTIME_PING_TIMEOUT_MS=20000
# LOG_FORMAT=pretty
# LOG_LEVEL=log
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_IDLE_TX_TIMEOUT_MS=30000
# DB_MIGRATION_LOCK_TIMEOUT_MS=5000
